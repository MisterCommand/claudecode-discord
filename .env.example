DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
BASE_PROJECT_DIR=/Users/you/projects
# Absolute directory containing the required read-only config.yaml.
# This directory must be outside BASE_PROJECT_DIR and must not be a symlink/junction.
BOT_CONFIG_DIR=/Users/you/claude-discord-config
RATE_LIMIT_PER_MINUTE=10
# Optional: enable read-only Inbox access for Admin channels on an on-premises
# Exchange server. Set all three values or leave all three blank.
EWS_URL=
EWS_EMAIL=
EWS_PASSWORD=
# Optional: export traces, metrics, and agent events directly to Honeycomb.
# Leave the key blank to keep observability disabled. Use the eu1 endpoint for EU teams.
HONEYCOMB_API_KEY=
HONEYCOMB_API_ENDPOINT=https://api.honeycomb.io
# Show estimated API cost in task results (set false for Max plan users)
SHOW_COST=true
# Optional: credentials for the embedded Gemini Business pool's sign-in flow.
# Only `npm run gemini -- login` reads them; the running bot starts pool accounts
# from proxy.yaml. Set the email and password together, or leave both blank.
# Use an app password where the identity provider requires one, and the base32
# secret for an authenticator-app MFA prompt.
GEMINI_SSO_EMAIL=
GEMINI_SSO_PASSWORD=
GEMINI_SSO_TOTP_SECRET=
# Optional: workspace id and sign-in provider used when capturing a new account.
GEMINI_SSO_TEAM_ID=
GEMINI_SSO_PROVIDER=
# Optional: Chrome/Chromium binary for the sign-in flow. chrome-launcher finds a
# normal desktop install; the Docker image sets this to /usr/bin/chromium.
CHROME_PATH=
# Claude providers (endpoint, API key, default model, subagent model, and effort
# level) and the /model list are configured in BOT_CONFIG_DIR/config.yaml.
# The optional embedded Gemini Business pool is configured in
# BOT_CONFIG_DIR/proxy.yaml (see proxy.example.yaml).

# Gemini
GEMINI_SSO_EMAIL=
GEMINI_SSO_PASSWORD=
GEMINI_SSO_TOTP_SECRET=
