DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
BASE_PROJECT_DIR=/Users/you/projects
# Absolute directory containing the required read-only config.yaml.
# This directory must be outside BASE_PROJECT_DIR and must not be a symlink/junction.
BOT_CONFIG_DIR=/Users/you/claude-discord-config
RATE_LIMIT_PER_MINUTE=10
# Optional: enable read-only Inbox access for Admin channels on an on-premises
# Exchange server. Set all three values or leave all three blank.
EWS_URL=
EWS_EMAIL=
EWS_PASSWORD=
# Optional: export traces, metrics, and agent events directly to Honeycomb.
# Leave the key blank to keep observability disabled. Use the eu1 endpoint for EU teams.
HONEYCOMB_API_KEY=
HONEYCOMB_API_ENDPOINT=https://api.honeycomb.io
# Show estimated API cost in task results (set false for Max plan users)
SHOW_COST=true
# Optional: pin a specific Claude model (leave blank to use CLI default)
# Examples: claude-opus-4-7, claude-sonnet-4-6, claude-haiku-4-5-20251001
CLAUDE_MODEL=
